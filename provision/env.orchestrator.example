# GitHub token (needs repo, issues, checks permissions)
GITHUB_TOKEN=ghp_your_token_here

# Provider credentials for orchestrator process (used for providers: lists
# that omit "credential" — falls back to these env vars).
# Claude runtime auth is CLAUDE_CODE_OAUTH_TOKEN only (ANTHROPIC_API_KEY is
# not a supported fallback). Fleet deploys generate these from
# /etc/orcest/config.yaml; the GitHub Actions secret of the same name is a
# separate review-workflow plane and is not copied to PVE.
# CLAUDE_CODE_OAUTH_TOKEN=...   (or CLAUDE_CODE_OAUTH_TOKENS=comma,sep)
# XAI_API_KEY=...               (for grok provider entries)
